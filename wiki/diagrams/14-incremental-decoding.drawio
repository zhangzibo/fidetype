<mxfile host="stealth-project"><diagram id="Incremental decoding" name="Incremental decoding"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Default frame route&lt;/b&gt;&lt;br&gt;decode_fn(stream)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="200" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Incremental route&lt;/b&gt; (opt-in)&lt;br&gt;StreamingTrustLayer(&lt;br&gt;incremental=factory)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="200" width="200" height="80" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;push(frame)&lt;/b&gt;&lt;br&gt;check + append row" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="230" y="0" width="200" height="60" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;end of utterance&lt;/b&gt;&lt;br&gt;build stream, frame T" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="470" y="0" width="230" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;decode the whole utterance&lt;/b&gt;&lt;br&gt;beam search + alignment + words" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="740" y="0" width="230" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;trust core&lt;/b&gt;&lt;br&gt;final decision" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><