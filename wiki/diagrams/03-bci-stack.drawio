<mxfile host="stealth-project"><diagram id="The BCI stack" name="The BCI stack"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;5. APPLICATION&lt;/b&gt;&lt;br&gt;Text entry, chat, device control for patients" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="620" height="70" as="geometry"/></mxCell><mxCell id="c3" value="software" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="15" width="200" height="40" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;4. DECODING  ★&lt;/b&gt;&lt;br&gt;AI that converts signals to intent or text" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="620" height="70" as="geometry"/></mxCell><mxCell id="c5" value="★ START HERE (software)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="105" width="200" height="40" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;3. DATA  ★&lt;/b&gt;&lt;br&gt;Datasets, formats, benchmarks" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="0" y="180" width="620" height="70" as="geometry"/></mxCell><mxCell id="c7" value="★ START HERE (software)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="195" width="200" height="40" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;2. SIGNAL&lt;/b&gt;&lt;br&gt;Filtering, artifact removal" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="0" y="270" width="620" height="70" as="geometry"/></mxCell><mxCell id="c9" value="software" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="285" width="200" height="40" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;1. HARDWARE&lt;/b&gt;&lt;br&gt;Implants, EEG, MEG, OPM-MEG, EMG sensors" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="0" y="360" width="620" height="70" as="geometry"/></mxCell><mxCell id="c11" value="lab + money" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="375" width="200" height="40" as="geometry"/></mxCell><mxCell id="c12" value="Why layers 3 and 4: no hardware needed, public data exists, AI skills transfer, and the papers say the decoder (encoder) is the bottleneck." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="450" width="840" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
