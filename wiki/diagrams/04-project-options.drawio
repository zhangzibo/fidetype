<mxfile host="stealth-project"><diagram id="Long-term project options" name="Long-term project options"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;A. Open brain-to-text toolkit + benchmark&lt;/b&gt;&lt;br&gt;Own code, open license, many public datasets, fair comparison.&lt;br&gt;&lt;br&gt;&lt;b&gt;Start now?&lt;/b&gt; Yes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="400" height="120" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;B. Small real-time decoder&lt;/b&gt;&lt;br&gt;Fast causal model. Shows text while the person types.&lt;br&gt;&lt;br&gt;&lt;b&gt;Start now?&lt;/b&gt; Yes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="440" y="0" width="400" height="120" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;C. Brain foundation model&lt;/b&gt;&lt;br&gt;Pretrain on many public brain datasets, then fine-tune for typing.&lt;br&gt;&lt;br&gt;&lt;b&gt;Start now?&lt;/b&gt; Later (more compute)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="0" y="150" width="400" height="120" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;D. Communication interface&lt;/b&gt;&lt;br&gt;App layer: LLM correction, confidence, n-best choices. Works with any decoder.&lt;br&gt;&lt;br&gt;&lt;b&gt;Start now?&lt;/b&gt; Yes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="440" y="150" width="400" height="120" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;To check before choosing:&lt;/b&gt; do toolkits like this already exist? (Braindecode, MOABB, LibriBrain tools)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="290" width="840" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
