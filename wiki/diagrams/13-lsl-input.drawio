nt / abort" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="490" y="195" width="260" height="50" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Merge&lt;/b&gt; 2 inlets by time&lt;br&gt;watermark + merge window (50 ms)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="490" y="255" width="260" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Loss&lt;/b&gt;: abort utterance, re-resolve,&lt;br&gt;send header again" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="490" y="315" width="260" height="45" as="geometry"/></mxCell><mxCell id="c18" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c6" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;StreamingTrustLayer&lt;/b&gt;&lt;br&gt;frozen config&lt;br&gt;frames or hypothesis route" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="820" y="90" width="200" height="100" as="geometry"/></mxCell><mxCell id="c20" value="NTS events" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c11" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;stdout&lt;/b&gt;&lt;br&gt;trust_decision JSON Lines&lt;br&gt;+ lsl provenance" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1070" y="40" width="210" height="60" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;LSL outlet&lt;/b&gt;&lt;br&gt;fidetype.decisions (Markers)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1070" y="130" width="210" height="60" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Apps&lt;/b&gt; (AAC, logger)&lt;br&gt;act only on is_final = true" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1070" y="220" width="210" height="60" as="geometry"/></mxCell><mxCell id="c24" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c19" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;replay-to-lsl&lt;/b&gt; (demo, tests)&lt;br&gt;NTS file → frames + events outlets" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="420" width="300" height="60" as="geometry"/></mxCell><mxCell id="c28" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=12;dashed=1;" edge="1" parent="1" source="c27" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
