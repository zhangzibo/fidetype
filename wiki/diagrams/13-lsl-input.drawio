<mxfile host="stealth-project"><diagram id="LSL input" name="LSL input"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;NTS decoder&lt;/b&gt;&lt;br&gt;frames stream (type NTS, V channels)&lt;br&gt;+ Markers stream (JSON events)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="250" height="70" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Class-probability stream&lt;/b&gt;&lt;br&gt;channel labels = vocab&lt;br&gt;values: log_probs / probs / logits" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="250" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Raw EEG / EMG stream&lt;/b&gt;&lt;br&gt;e.g. OpenBCI GUI, own BrainFlow script&lt;br&gt;needs a SignalDecoder" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="0" y="180" width="250" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Text decoder&lt;/b&gt;&lt;br&gt;Markers: JSON hypothesis events&lt;br&gt;or plain strings" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="0" y="270" width="250" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;LSL&lt;/b&gt;&lt;br&gt;localhost / LAN&lt;br&gt;LSL timestamps" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="120" height="110" as="geometry"/></mxCell><mxCell id="c7" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;font