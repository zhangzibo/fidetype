<mxfile host="stealth-project"><diagram id="roadmap-standard" name="Long-term roadmap"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Fidetype long-term roadmap: from v0.1 to a full neural input standard&lt;/b&gt; (2026-11-10)" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=16;align=left;verticalAlign=middle;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1390" height="28" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;v0.1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;M0–M7, by 2026-11-15&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="160" y="38" width="150" height="40" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Q4 2026&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;11-16 → 12-31&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#eeeeee;strokeColor=#cccccc;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="38" width="260" height="40" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Q1 2027&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;01 → 03&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#eeeeee;strokeColor=#cccccc;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="38" width="260" height="40" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Q2 2027&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;04 → 06&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#eeeeee;strokeColor=#cccccc;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="38" width="260" height="40" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;H2 2027&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;07 → 12&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#eeeeee;strokeColor=#cccccc;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1130" y="38" width="260" height="40" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Spec + SDKs&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=60;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="150" height="132" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Runtime&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=60;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="236" width="150" height="132" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Ecosystem&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;opacity=60;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="382" width="150" height="202" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Research&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=60;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="598" width="150" height="62" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Outside people&lt;br&gt;(ext. blocked, user-owned)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;opacity=60;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="0" y="674" width="150" height="132" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;v0.1&lt;/b&gt;&lt;br&gt;Spec v0.1&lt;br&gt;Python core 11.5k lines&lt;br&gt;Trust core v0&lt;br&gt;Benchmark v0.1&lt;br&gt;First adapters (B2T '25)&lt;br&gt;Paper drafts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="160" y="90" width="150" height="570" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;P1 Spec 1.0 RC&lt;/b&gt; · proto3 = source of truth, JSON Schema, semconv YAML per modality, versioning, FEPs, generated docs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="90" width="530" height="62" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;P2 SDKs&lt;/b&gt; · Python + C core first, then Rust, TypeScript, C#, Kotlin · PyPI, crates.io, npm, vcpkg/Conan" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="160" width="530" height="62" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;P7 Conformance kit + &quot;Fidetype-compatible&quot;&lt;/b&gt; · nts-conform CLI, levels Core / Full / Trust-ready" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="860" y="90" width="530" height="62" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;P3 Collector&lt;/b&gt; · receivers → processors (trust, calibration, LM, privacy) → exporters (IME, AAC, files)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="236" width="530" height="62" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;P5 Trust layer, product grade&lt;/b&gt; · personalisation · conformal risk control · provenance ledger · consent + neural-data laws · on-device" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="306" width="1070" height="62" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;P4 Adapters&lt;/b&gt; · dataset replay first (B2T '25, KT-sEMG, Willett, Toronto) → LSL, BrainFlow, MNE → BCI2000, OpenViBE, Emotiv, Muse, Neurosity, EMG bands, Apple HID" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="382" width="800" height="62" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;P6 Benchmark + leaderboard&lt;/b&gt; · eWPM vs no-BCI · NTS submissions" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="452" width="260" height="62" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;P8 Docs, website, demo&lt;/b&gt; · quickstarts · &lt;b&gt;3 devices → 1 stream → 1 trust layer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="452" width="530" height="62" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;P9 Governance&lt;/b&gt; · licence decision, DCO, CODEOWNERS, FEP index" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="522" width="530" height="62" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;P11 Research track&lt;/b&gt; · EMG decoders · cross-subject pretraining · LLM priors with guards · Paper 1, Paper 2, spec paper" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="598" width="1070" height="62" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;P10 Adoption&lt;/b&gt; · arXiv (endorsement) → NeurotechX, OpenBCI, BCI Society, Show HN, Reddit, Discord → 5–10 groups (labs, LSL, OpenBCI, AAC)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;dashed=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="674" width="800" height="62" as="geometry"/></mxCell><mxCell id="c25" value="Spec 1.0 Stable (outside reviewers) · hardware · vendor terms · registry tokens · ethics, volunteers, user studies · legal review · peer review · foundation (LF AI &amp;amp; Data, NumFOCUS, ...)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;dashed=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="744" width="1070" height="62" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id