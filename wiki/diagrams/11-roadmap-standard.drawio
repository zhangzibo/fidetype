<mxfile host="stealth-project"><diagram id="roadmap-standard" name="Long-term roadmap"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Fidetype long-term roadmap: from v0.1 to a full neural input standard&lt;/b&gt; (2026-11-10; P12, P13 added 2026-11-11; P14 added 2026-11-15; P15 Frontier added 2026-11-15 and leads; P16 later; P17, P18 after the roadmap, added 2026-11-20)" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=16;align=left;verticalAlign=middle;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1390" height="28" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;v0.1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;M0–M7, by 2026-11-15&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="160" y="38" width="150" height="40" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Q4 2026&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;11-16 → 12-31&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#eeeeee;strokeColor=#cccccc;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="38" width="260" height="40" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Q1 2027&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;01 → 03&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#eeeeee;strokeColor=#cccccc;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="38" width="260" height="40" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Q2 2027&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;04 → 06&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#eeeeee;strokeColor=#cccccc;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="38" width="260" height="40" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;H2 2027&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#666666&quot;&gt;07 → 12&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#eeeeee;strokeColor=#cccccc;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1130" y="38" width="260" height="40" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Spec + SDKs&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=60;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="166" width="150" height="132" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Runtime&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=60;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="312" width="150" height="132" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Ecosystem&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;opacity=60;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="458" width="150" height="202" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Research&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=60;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="674" width="150" height="62" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Outside people&lt;br&gt;(ext. blocked, user-owned)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;opacity=60;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="0" y="826" width="150" height="132" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;v0.1&lt;/b&gt;&lt;br&gt;Spec v0.1 + FEPs&lt;br&gt;Python core&lt;br&gt;Trust core v0&lt;br&gt;Benchmark v0.1&lt;br&gt;First adapters (B2T '25, LSL, WebSocket)&lt;br&gt;Paper drafts (PUB track)&lt;br&gt;&lt;br&gt;&lt;i&gt;Early starts (11-14): NTS 1.0 RC2 draft; Python, TypeScript, Rust SDKs ready to publish; collector draft&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="160" y="90" width="150" height="646" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;P1 Spec 1.0 RC&lt;/b&gt; · proto3 = source of truth, JSON Schema, semconv YAML per modality, versioning, FEPs, generated docs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="166" width="530" height="62" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;P2 SDKs&lt;/b&gt; · Python, TypeScript, Rust = 1.0 set (exist, not published) · after 1.0: C core, C#, Kotlin · PyPI, crates.io, npm, vcpkg/Conan" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="236" width="530" height="62" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;P7 Conformance kit + &quot;Fidetype-compatible&quot;&lt;/b&gt; · nts-conform CLI, levels Core / Full / Trust-ready" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="860" y="166" width="530" height="62" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;P3 Collector&lt;/b&gt; · receivers → processors (trust, calibration, LM, privacy) → exporters (IME, AAC, files)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="312" width="530" height="62" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;P5 Trust layer, product grade&lt;/b&gt; · personalisation · conformal risk control · provenance ledger · consent + neural-data laws · on-device" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="382" width="1070" height="62" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;P4 Adapters&lt;/b&gt; · dataset replay first (B2T '25, KT-sEMG, Willett, Toronto) → LSL, BrainFlow, MNE → BCI2000, OpenViBE, Emotiv, Muse, Neurosity, EMG bands, Apple HID" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="458" width="800" height="62" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;P6 Benchmark + leaderboard&lt;/b&gt; · eWPM vs no-BCI · NTS submissions" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="528" width="260" height="62" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;P8 Docs, website, demo&lt;/b&gt; · quickstarts · &lt;b&gt;3 devices → 1 stream → 1 trust layer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="528" width="530" height="62" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;P9 Governance&lt;/b&gt; · licence decision, DCO, CODEOWNERS, FEP index" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="598" width="530" height="62" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;P11 Research track&lt;/b&gt; · EMG decoders · cross-subject pretraining · LLM priors with guards · Paper 1, Paper 2, spec paper" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="674" width="1070" height="62" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;P10 Adoption&lt;/b&gt; · arXiv (endorsement) → NeurotechX, OpenBCI, BCI Society, Show HN, Reddit, Discord → 5–10 groups (labs, LSL, OpenBCI, AAC)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;dashed=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="590" y="826" width="800" height="62" as="geometry"/></mxCell><mxCell id="c25" value="Spec 1.0 Stable (outside reviewers) · hardware · vendor terms · registry tokens · ethics, volunteers, user studies · legal review · peer review · foundation (LF AI &amp;amp; Data, NumFOCUS, ...)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;dashed=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="896" width="1070" height="62" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;exitX=1;exitY=0.166;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;exitX=0.755;exitY=1;exitDx=0;exitDy=0;entryX=0.245;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;exitX=0.774;exitY=0;exitDx=0;exitDy=0;entryX=0.264;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;dashed=1;exitX=0.774;exitY=1;exitDx=0;exitDy=0;entryX=0.5125;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Gates&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=12;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="1192" width="150" height="44" as="geometry"/></mxCell><mxCell id="c33" value="v0.1 tag" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="170" y="1192" width="130" height="44" as="geometry"/></mxCell><mxCell id="c34" value="Leaderboard public" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="330" y="1192" width="240" height="44" as="geometry"/></mxCell><mxCell id="c35" value="Spec 1.0 RC + Python/TS/Rust 1.0" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="600" y="1192" width="240" height="44" as="geometry"/></mxCell><mxCell id="c36" value="3-device demo runs" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="870" y="1192" width="240" height="44" as="geometry"/></mxCell><mxCell id="c37" value="Outside decoder emits NTS" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1140" y="1192" width="240" height="44" as="geometry"/></mxCell><mxCell id="c38" value="Legend: solid box = we build it (agents write, user reviews). Dashed grey = depends on outside people or the user (&lt;b&gt;externally_blocked&lt;/b&gt;, never late). Yellow = scope added later (P12, P13 on 2026-11-11; P14 on 2026-11-15). Purple, top row = P15 Frontier (new north star, 2026-11-15): it leads; P1–P14 keep their IDs. Pink row = P16 write side (user idea, 2026-11-15): later, after the P15 core work; real stimulation is ext. blocked. Teal rows = P17, P18 (added 2026-11-20): after the roadmap, 2028 onward; the time columns above do not apply. Arrows = critical path. Rule: replay before hardware; schema before SDKs; demo + benchmark before outreach." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=11;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="0" y="1248" width="1390" height="34" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;P12 Beyond text&lt;/b&gt; · output profiles: discrete intent (click, commands), continuous control (cursor), speech · gated, rate-limited actuation · BCI HID" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1130" y="312" width="260" height="62" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;P13 Benchmark hub&lt;/b&gt; · extends P6 · MEG, implant, EMG replay · CRC/LTT guarantee reports · controls · later all intent" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1130" y="528" width="260" height="62" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Value first&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;opacity=60;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="750" width="150" height="62" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;P14 Value first: useful toolkit&lt;/b&gt; · pretrained decoders, one-line load, NTS out · drop-in trust wrapper + 10-min quickstart · one-command live decode (LSL, BrainFlow, OpenBCI) · safe-WPM column in P6 · recorded EMG demo · write-ups · AAC example (P14-01 … P14-09)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="320" y="750" width="530" height="62" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;Frontier&lt;/b&gt;&lt;br&gt;(leads from 2026-11-15)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6d0de;strokeColor=#996185;opacity=60;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="150" height="62" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;P15 Frontier&lt;/b&gt; (north star: language from any body signal, self-improving, never puts words in the user's mouth) · &lt;b&gt;F1&lt;/b&gt; safe self-improving BCI (E2: T12 / T15 replay, update gate) · &lt;b&gt;F2&lt;/b&gt; faithful LLM decoding + hallucination benchmark (E3) · &lt;b&gt;F3&lt;/b&gt; cross-body language model, minutes of data (E1) · literature check · demo · write-ups (P15-00 … P15-12)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#e6d0de;strokeColor=#996185;strokeWidth=2.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="320" y="90" width="800" height="62" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Write side&lt;/b&gt;&lt;br&gt;(later, exploration)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8d7e3;strokeColor=#b5627d;opacity=60;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="972" width="150" height="62" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;P16 Write side: emotion, memory&lt;/b&gt; · literature · affect decoding on public data with abstention · ethics · offline closed-loop design · real stimulation: ext. blocked (P16-01 … P16-05)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=12;fillColor=#f8d7e3;strokeColor=#b5627d;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1130" y="972" width="260" height="62" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;After the roadmap&lt;/b&gt;&lt;br&gt;(2028 onward, added 2026-11-20)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5ede9;strokeColor=#3d8b80;opacity=60;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="1046" width="150" height="132" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;P17 Daily use: product, people, privacy&lt;/b&gt; (2028) · installable AAC app on the trust guard · on-device learning (F1 loop, no raw data leaves the device) · federated / self-supervised adaptation · hosted hub: build + staging · own data protocol + consent · regulatory map · &lt;i&gt;ext. blocked: home use, ethics approval, volunteer recordings, hub launch (user), clinical / regulatory filing&lt;/i&gt; (P17-00 … P17-11)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5ede9;strokeColor=#3d8b80;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="320" y="1046" width="1070" height="62" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;P18 Reach: hardware, models, languages, outputs, standards&lt;/b&gt; (2028 → mid 2029) · open low-cost EMG wristband + driver · cross-body foundation model on public data · zh and other languages beyond en / es · commands, cursor, speech output under the same no-false-words guarantee · standards package · &lt;i&gt;ext. blocked: prototype build (hardware), standards body work item&lt;/i&gt; (P18-01 … P18-09)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5ede9;strokeColor=#3d8b80;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="320" y="1116" width="1070" height="62" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
