<mxfile host="stealth-project"><diagram id="WebSocket input" name="WebSocket input"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Decoder (producer)&lt;/b&gt;&lt;br&gt;stream id &lt;i&gt;acme-1&lt;/i&gt;&lt;br&gt;header, then events with ws_seq 1, 2, 3 ..." style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="230" height="80" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;fidetype ws replay-to-ws&lt;/b&gt;&lt;br&gt;NTS file, paced by frame times&lt;br&gt;ws_batch of N frames" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="0" y="110" width="230" height="80" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;/nts: IngestCore&lt;/b&gt; (one state per stream)&lt;br&gt;• subprotocol nts-ws.0.1; header first; token: Bearer or ws_auth&lt;br&gt;• duplicates dropped (resend is safe)&lt;br&gt;• reorder window 16 events / 0.25 s&lt;br&gt;• missing ws_seq = gap&lt;br&gt;• broken connection: wait 10 s for a resume&lt;br&gt;• resume: ws_welcome seq = last released; producer resends the rest" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="300" y="0" width="300" height="190" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;No decision on a cut utterance&lt;/b&gt;&lt;br&gt;gap or lost stream: abort the open utterance;&lt;br&gt;drop the frames up to the next segment_end" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="300" y="215" width="300" height="75" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;WSTrustRunner&lt;/b&gt;&lt;br&gt;StreamingTrustLayer&lt;br&gt;one session per stream id&lt;br&gt;trust_decision + ws record&lt;br&gt;(server / e2e latency)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="670" y="40" width="230" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;/decisions: OutputHub&lt;/b&gt;&lt;br&gt;ws_seq 1, 2, 3 ... (no gaps)&lt;br&gt;ring of 4096: resume with from_seq&lt;br&gt;slow subscriber: 1013, resubscribe" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="960" y="0" width="270" height="95" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;/events tap&lt;/b&gt;&lt;br&gt;NTS events + stream_id (monitoring)&lt;br&gt;no replay" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="960" y="120" width="270" height="70" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Browser page&lt;/b&gt; (TS SDK)&lt;br&gt;DecisionSubscriber: gap → resubscribe&lt;br&gt;acts on final COMMIT only" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1300" y="0" width="250" height="95" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;fidetype ws subscribe&lt;/b&gt;&lt;br&gt;decisions as JSON Lines" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1300" y="120" width="250" height="70" as="geometry"/></mxCell><mxCell id="e11" value="NTS events" style="endArrow=block;html=1;fontSize=12;strokeWidth=1.5;exitX=1;exitY=0.25;entryX=0;entryY=0.12;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="NTS events" style="endArrow=block;html=1;fontSize=12;strokeWidth=1.5;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="ws_welcome, ws_ack&lt;br&gt;(window 4096)" style="endArrow=block;html=1;fontSize=11;strokeWidth=1.5;dashed=1;exitX=0;exitY=0.42;entryX=1;entryY=0.85;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="ordered events" style="endArrow=block;html=1;fontSize=12;strokeWidth=1.5;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="" style="endArrow=block;html=1;fontSize=12;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="decisions" style="endArrow=block;html=1;fontSize=12;strokeWidth=1.5;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="events" style="endArrow=block;html=1;fontSize=12;strokeWidth=1.5;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="" style="endArrow=block;html=1;fontSize=12;strokeWidth=1.5;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="endArrow=block;html=1;fontSize=12;strokeWidth=1.5;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="endArrow=block;html=1;fontSize=12;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
