<mxfile host="stealth-project"><diagram id="Control events" name="Control events"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="dec" value="&lt;b&gt;Decoder&lt;/b&gt; (causal, 50 Hz)&lt;br&gt;control event: tick, values,&lt;br&gt;std per axis" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="220" height="80" as="geometry"/></mxCell><mxCell id="hdr" value="&lt;b&gt;Header&lt;/b&gt; control_declaration&lt;br&gt;units, frame, rate_hz,&lt;br&gt;uncertainty, click_intent" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="0" y="120" width="220" height="80" as="geometry"/></mxCell><mxCell id="sq" value="&lt;b&gt;signal_quality&lt;/b&gt;&lt;br&gt;(index, spec 3.9)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="290" y="-110" width="200" height="60" as="geometry"/></mxCell><mxCell id="en" value="&lt;b&gt;control_enable&lt;/b&gt;&lt;br&gt;engage / stop (switch,&lt;br&gt;caregiver; never the decoder)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="220" height="80" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b&gt;No-signal gates&lt;/b&gt; (HOLD)&lt;br&gt;quality &amp;lt; min; stale input;&lt;br&gt;absent axis; |raw - v_ns| &amp;lt;= r" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="270" y="0" width="240" height="80" as="geometry"/></mxCell><mxCell id="shr" value="&lt;b&gt;Conformal shrinkage&lt;/b&gt;&lt;br&gt;r = q * max(std) (split conformal)&lt;br&gt;v = raw * max(0, 1 - r / |raw|)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="270" y="120" width="240" height="80" as="geometry"/></mxCell><mxCell id="ho" value="&lt;b&gt;Hand-off&lt;/b&gt;&lt;br&gt;authority 0 -&amp;gt; 1 over 1 s after engage;&lt;br&gt;rest from a human channel" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="240" height="80" as="geometry"/></mxCell><mxCell id="cl" value="&lt;b&gt;Clamps&lt;/b&gt;&lt;br&gt;|v| &amp;lt;= v_max; |dv| &amp;lt;= a_max dt;&lt;br&gt;never faster than the gated target" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="850" y="120" width="240" height="80" as="geometry"/></mxCell><mxCell id="dm" value="&lt;b&gt;Dead-man&lt;/b&gt;&lt;br&gt;no motion before engage;&lt;br&gt;stop is latched; poll -&amp;gt; HOLD" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="560" y="300" width="240" height="80" as="geometry"/></mxCell><mxCell id="td" value="&lt;b&gt;trust_decision&lt;/b&gt; profile control&lt;br&gt;state act / attenuate / hold / stop&lt;br&gt;velocity, gain, v_max, ttl_s, audit" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1140" y="120" width="250" height="90" as="geometry"/></mxCell><mxCell id="br" value="&lt;b&gt;Bridge&lt;/b&gt; (cursor, HID Report 3)&lt;br&gt;applies velocity until next decision&lt;br&gt;or ttl_s; then zero" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1140" y="280" width="250" height="80" as="geometry"/></mxCell><mxCell id="clk" value="&lt;b&gt;Click&lt;/b&gt; = FEP-0003 intent&lt;br&gt;risk class, threshold;&lt;br&gt;no COMMIT while stopped" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="850" y="-110" width="240" height="80" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;" edge="1" parent="1" source="dec" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gate" target="shr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;" edge="1" parent="1" source="shr" target="ho"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;" edge="1" parent="1" source="ho" target="cl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;" edge="1" parent="1" source="cl" target="td"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;" edge="1" parent="1" source="td" target="br"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;" edge="1" parent="1" source="hdr" target="shr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sq" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;" edge="1" parent="1" source="en" target="dm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="dm" target="ho"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="clk" target="td"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Each stage only removes motion. MC_RTT result: at level 0.9 the radius (89 mm/s) is wider than most decoded speeds (46 mm/s), so the output never moves; zero input drifts 13.3 mm/s raw, 0 gated." style="text;html=1;whiteSpace=wrap;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="270" y="430" width="1120" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
