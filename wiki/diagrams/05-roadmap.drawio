<mxfile host="stealth-project"><diagram id="Roadmap" name="Roadmap"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Phase 0&lt;br&gt;(weeks)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Learn. Run small models on the Spanish data." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="170" height="130" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Phase 1&lt;br&gt;(months)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Build A: own toolkit (MIT) + baselines + benchmark." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="210" y="0" width="170" height="130" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Phase 2&lt;/b&gt;&lt;br&gt;&lt;br&gt;Research B: small real-time decoder → first paper." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="420" y="0" width="170" height="130" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Phase 3&lt;/b&gt;&lt;br&gt;&lt;br&gt;Add C (pretraining) or D (product), based on results." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="630" y="0" width="170" height="130" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Later&lt;/b&gt;&lt;br&gt;&lt;br&gt;Connect real hardware when wearable sensors are cheap." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="840" y="0" width="170" height="130" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
