<mxfile host="stealth-project"><diagram id="Open-source path" name="Open-source path"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Open-source path: from paper to standard&lt;/b&gt; (playbook, 2026-11-08)" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=15;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1000" height="26" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Stage&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=12;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="44" width="110" height="74" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Borrows from&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=12;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="142" width="110" height="26" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Exit criteria&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=12;align=left;verticalAlign=top;fontColor=#666666;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="0" y="186" width="110" height="150" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;0  Credibility core&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;now → Paper 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="120" y="44" width="190" height="74" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;SGLang&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="120" y="142" width="90" height="26" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;OTel&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="220" y="142" width="90" height="26" as="geometry"/></mxCell><mxCell id="c9" value="Paper 1 on arXiv.&lt;br&gt;Benchmark reruns from one command.&lt;br&gt;Spec v0.1 + validator, with stability levels.&lt;br&gt;Small semver core API. No hidden magic." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="120" y="186" width="190" height="150" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;1  Launch&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;with the Paper 1 arXiv release&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="332" y="44" width="190" height="74" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;" edge="1" parent="1" source="c6" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="&lt;b&gt;SGLang&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="332" y="142" width="90" height="26" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;LangChain&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="432" y="142" width="90" height="26" as="geometry"/></mxCell><mxCell id="c14" value="Public trust leaderboard.&lt;br&gt;&quot;10-line recipe&quot; for any decoder.&lt;br&gt;Adapters: LSL, BIDS, Brain2Qwerty-style, NeuralBench.&lt;br&gt;1+ outside decoder runs it." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="332" y="186" width="190" height="150" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;2  Community engine&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="544" y="44" width="190" height="74" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;" edge="1" parent="1" source="c10" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;SGLang&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="544" y="142" width="90" height="26" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;LangChain&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="644" y="142" width="90" height="26" as="geometry"/></mxCell><mxCell id="c19" value="Labs own their adapters (CODEOWNERS, own CI).&lt;br&gt;Day-0 support for new datasets.&lt;br&gt;Release every 2 weeks. Quarterly roadmap.&lt;br&gt;Exact benchmark configs public." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="544" y="186" width="190" height="150" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;3  Standard&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="756" y="44" width="190" height="74" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;" edge="1" parent="1" source="c15" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="&lt;b&gt;OTel&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="756" y="142" width="90" height="26" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;BIDS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="856" y="142" width="90" height="26" as="geometry"/></mxCell><mxCell id="c24" value="Spec in its own repo. FEPs.&lt;br&gt;Shared field names.&lt;br&gt;Spec v1.0 co-authored by 2–3 decoder labs + 1 clinical group.&lt;br&gt;Bridges to LSL and BIDS." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="756" y="186" width="190" height="150" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;4  Foundation&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="968" y="44" width="190" height="74" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;" edge="1" parent="1" source="c20" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;OTel&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="968" y="142" width="90" height="26" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;BIDS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1068" y="142" width="90" height="26" as="geometry"/></mxCell><mxCell id="c29" value="≥3 maintainers from ≥2 employers.&lt;br&gt;Outside adopters.&lt;br&gt;LF AI &amp;amp; Data or NumFOCUS.&lt;br&gt;Elected steering group, company cap." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="968" y="186" width="190" height="150" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;5  Company&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1180" y="44" width="190" height="74" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;" edge="1" parent="1" source="c25" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="&lt;b&gt;LangChain&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1180" y="142" width="90" height="26" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;SGLang&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1280" y="142" width="90" height="26" as="geometry"/></mxCell><mxCell id="c34" value="Open core on top: audit dashboards, compliance reports, device profiles, OEM.&lt;br&gt;Project stays neutral.&lt;br&gt;Brand decided before stage 4." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=6;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1180" y="186" width="190" height="150" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Success metric = decoders emitting NeuralTextStream, not stars.&lt;/b&gt;  Also: citations of the paper and spec, external contributors, one device maker." style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="358" width="1250" height="44" as="geometry"/></mxCell><mxCell id="c36" value="Legend:  &lt;b&gt;SGLang&lt;/b&gt; = paper, benchmarks, day-0 support.  &lt;b&gt;LangChain&lt;/b&gt; = integrations, recipes, open core (not its churn).  &lt;b&gt;OTel&lt;/b&gt; = neutral spec and governance.  &lt;b&gt;BIDS&lt;/b&gt; = neuro community standard.  Red border = current stage." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=11;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="120" y="414" width="1250" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
