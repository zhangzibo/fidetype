<mxfile host="stealth-project"><diagram id="v1 vs v2 pipeline" name="v1 vs v2 pipeline"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;v1&lt;/b&gt;: Nature Neuroscience 2026&lt;br&gt;35 people, about 1 h each, Spanish" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="380" height="44" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;v2&lt;/b&gt;: Meta preprint 2026&lt;br&gt;9 people, 10 h each, English" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="0" width="380" height="44" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Input&lt;/b&gt;: 0.5 s of signal for EACH key press&lt;br&gt;&lt;i&gt;needs key timing → not real-time&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="0" y="60" width="380" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Conv network&lt;/b&gt; (BrainModule)&lt;br&gt;1 letter per window" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="0" y="170" width="380" height="80" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Transformer&lt;/b&gt;&lt;br&gt;uses context of the full sentence" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="0" y="280" width="380" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;9-gram letter model&lt;/b&gt;&lt;br&gt;corrects spelling" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="0" y="390" width="380" height="80" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Result: 29% of letters wrong&lt;/b&gt; (CER, MEG)&lt;br&gt;EEG: 65%" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="0" y="500" width="380" height="80" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Input&lt;/b&gt;: continuous signal for the full sentence&lt;br&gt;&lt;i&gt;no key timing needed&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="460" y="60" width="380" height="80" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;BrainModule + Conformer&lt;/b&gt;&lt;br&gt;letters over time (CTC loss)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="460" y="170" width="380" height="80" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;CTC tokenizer&lt;/b&gt;&lt;br&gt;cuts at predicted spaces → &amp;quot;brain words&amp;quot;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="460" y="280" width="380" height="80" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;LLM&lt;/b&gt; (Qwen3-4B + LoRA)&lt;br&gt;reads CTC text + brain words → writes sentence" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="460" y="390" width="380" height="80" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Result: 39% of words wrong&lt;/b&gt; (WER)&lt;br&gt;best person: 22%" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="500" width="380" height="80" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Key lesson:&lt;/b&gt; 10× more data per person made decoding without key timing possible. Accuracy still improves with more data (no plateau)." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="0" y="610" width="840" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
