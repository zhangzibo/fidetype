<mxfile host="stealth-project"><diagram id="Intent events" name="Intent events"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Decoder&lt;/b&gt;&lt;br&gt;intent event: candidates + scores&lt;br&gt;(or v0.1 decision, command frames)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="210" height="80" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Header&lt;/b&gt; intent_declaration&lt;br&gt;id, risk class, role&lt;br&gt;(null / confirm / cancel / undo)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="0" y="120" width="210" height="80" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Calibrate&lt;/b&gt;&lt;br&gt;frozen temperature T&lt;br&gt;(icfg-... config)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="250" y="0" width="200" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Gates&lt;/b&gt; (only remove COMMITs)&lt;br&gt;null intent, no probabilities,&lt;br&gt;low signal quality, p &amp;lt; 0.5 floor" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="490" y="0" width="230" height="80" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Per-class threshold&lt;/b&gt;&lt;br&gt;safe a=0.10 / undoable 0.05 /&lt;br&gt;irreversible 0.01 (LTT or CRC)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="760" y="0" width="240" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;COMMIT&lt;/b&gt;&lt;br&gt;safe or undoable intent" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1040" y="0" width="200" height="70" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;ARM&lt;/b&gt; = OFFER&lt;br&gt;confirm_required&lt;br&gt;(irreversible: no action yet)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1040" y="110" width="200" height="80" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;OFFER&lt;/b&gt; top-k set or &lt;b&gt;ABSTAIN&lt;/b&gt;&lt;br&gt;(user picks; never actuated)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="760" y="130" width="240" height="60" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Confirmation&lt;/b&gt;&lt;br&gt;next unit = confirm intent&lt;br&gt;(irreversible threshold)&lt;br&gt;or intent_feedback (switch)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1040" y="230" width="200" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;COMMIT&lt;/b&gt;&lt;br&gt;confirmation_of = armed unit&lt;br&gt;other unit / cancel drops it" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1280" y="230" width="200" height="90" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Bridge&lt;/b&gt; (HID, device)&lt;br&gt;acts on final COMMIT only" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1280" y="0" width="200" height="70" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;undo&lt;/b&gt; COMMIT&lt;br&gt;undo_of = last undoable unit&lt;br&gt;(never an irreversible one)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1280" y="110" width="200" height="80" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;No-signal reference&lt;/b&gt; (fit time, no labels): raise each class threshold above&lt;br&gt;the decoder&#x27;s top-1 p on zero / rest input. Report uniform + zero-input controls." style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="250" y="130" width="470" height="60" as="geometry"/></mxCell><mxCell id="c15" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="risk classes" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=12;dashed=1;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="p &amp;gt;= thr" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="irreversible" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="below" style="endArrow=block;html=1;rounded=0;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"