<mxfile host="stealth-project"><diagram id="Benchmark hub" name="Benchmark hub"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="src" value="&lt;b&gt;Original source&lt;/b&gt;&lt;br&gt;Dryad, Hugging Face, Borealis&lt;br&gt;(the hub never re-hosts data)" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="240" height="70" as="geometry"/></mxCell><mxCell id="reg" value="&lt;b&gt;Dataset registry&lt;/b&gt; datasets-0.1.json&lt;br&gt;id + version + revision, licence,&lt;br&gt;research_only, citation, forms,&lt;br&gt;SHA-256, verify, download, adapters" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="0" y="130" width="240" height="100" as="geometry"/></mxCell><mxCell id="split" value="&lt;b&gt;Split file&lt;/b&gt; tracks-v0.2&lt;br&gt;salted hashes only" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="200" height="60" as="geometry"/></mxCell><mxCell id="local" value="&lt;b&gt;Local copy&lt;/b&gt;&lt;br&gt;download -&gt; verify&lt;br&gt;(checksum + fingerprints)&lt;br&gt;-&gt; prepare (cache)" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="300" y="0" width="200" height="90" as="geometry"/></mxCell><mxCell id="ad" value="&lt;b&gt;Replay adapter&lt;/b&gt; (our code)&lt;br&gt;unit.ref -&gt; one NTS stream&lt;br&gt;licence keys, neural time,&lt;br&gt;deterministic, unit hash" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="560" y="0" width="230" height="90" as="geometry"/></mxCell><mxCell id="tr" value="&lt;b&gt;Transport&lt;/b&gt;&lt;br&gt;file | LSL | WebSocket&lt;br&gt;same events, same decisions" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="560" y="130" width="230" height="70" as="geometry"/></mxCell><mxCell id="pol" value="&lt;b&gt;Trust policy&lt;/b&gt;&lt;br&gt;frozen config id&lt;br&gt;COMMIT / OFFER / ABSTAIN" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="560" y="240" width="230" height="70" as="geometry"/></mxCell><mxCell id="sc" value="&lt;b&gt;Scorer v0.2&lt;/b&gt;&lt;br&gt;controls: shuffled, zeros, null&lt;br&gt;safe WPM, guarantee, CIs" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="240" width="200" height="80" as="geometry"/></mxCell><mxCell id="card" value="&lt;b&gt;Result card&lt;/b&gt; (no text)&lt;br&gt;+ rerun recipe: dataset, split,&lt;br&gt;adapter hash, decoder, policy,&lt;br&gt;scorer, command, level" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="360" width="200" height="100" as="geometry"/></mxCell><mxCell id="site" value="&lt;b&gt;Hub site&lt;/b&gt; (static)&lt;br&gt;per-track pages, guarantee +&lt;br&gt;control columns, RESEARCH ONLY,&lt;br&gt;rerun: rescore / replay / full" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="360" width="230" height="100" as="geometry"/></mxCell><mxCell id="gov" value="&lt;b&gt;Governance&lt;/b&gt;&lt;br&gt;candidate -&gt; registered&lt;br&gt;-&gt; deprecated / withdrawn&lt;br&gt;licence + consent review" style="whiteSpace=wrap;html=1;fontSize=13;ro