<mxfile host="stealth-project"><diagram id="What Brain2Qwerty does" name="What Brain2Qwerty does"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;1. Person types&lt;/b&gt;&lt;br&gt;a sentence on a hidden keyboard&lt;br&gt;&lt;i&gt;(cannot see the text)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="190" height="90" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;2. MEG scanner&lt;/b&gt;&lt;br&gt;records brain magnetic fields&lt;br&gt;306 sensors, 1000 samples/s" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="260" y="40" width="190" height="90" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;3. AI model&lt;/b&gt;&lt;br&gt;converts brain signals&lt;br&gt;to letters and words" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="520" y="40" width="190" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;4. Predicted text&lt;/b&gt;&lt;br&gt;&amp;quot;el beneficio supera&lt;br&gt;los riesgos&amp;quot;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="780" y="40" width="190" height="90" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Important:&lt;/b&gt; the signal comes mostly from the &lt;b&gt;motor cortex&lt;/b&gt; (finger movement). The model reads the &lt;b&gt;act of typing&lt;/b&gt;, not thought. Errors follow the keyboard layout." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="0" y="170" width="970" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
