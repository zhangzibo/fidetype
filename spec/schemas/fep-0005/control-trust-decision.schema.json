{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/zhangzibo/fidetype/spec/schemas/fep-0005/control-trust-decision.schema.json",
 "title": "FEP-0005 control trust_decision (one actuation command per decoder tick)",
 "description": "Structural schema. Semantic rules (state fits action, zero velocity on hold/stop, speed <= v_max, no motion with a no-signal reason, re-engage after stop, a moving tick never reused, seq across profiles, no intent COMMIT while stopped) are checked by the fep-0005 conformance profile.",
 "type": "object",
 "required": ["type", "profile", "tick", "is_final", "action", "state", "velocity", "gain", "units", "p_top1",
              "score_semantics", "v_max", "ttl_s", "engagement"],
 "properties": {
  "type": {"const": "trust_decision"},
  "profile": {"const": "control"},
  "session": {"type": "string"},
  "seq": {"type": "integer", "minimum": 0},
  "tick": {"type": "integer", "minimum": 0},
  "t": {"type": "number"},
  "is_final": {"const": true},
  "action": {"enum": ["COMMIT", "ABSTAIN"]},
  "state": {"enum": ["act", "attenuate", "hold", "stop"]},
  "velocity": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "number"}},
  "raw": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "number"}},
  "gain": {"type": "number", "minimum": 0, "maximum": 1},
  "units": {"type": "string"},
  "radius": {"type": "number", "minimum": 0},
  "level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
  "authority": {"type": "number", "minimum": 0, "maximum": 1},
  "engagement": {"type": "integer", "minimum": 0},
  "v_max": {"type": "number", "exclusiveMinimum": 0},
  "ttl_s": {"type": "number", "exclusiveMinimum": 0},
  "reason": {"type": "string"},
  "reasons": {"type": "array", "items": {"type": "string"}},
  "p_top1": {"type": "null"},
  "score_semantics": {"enum": ["calibrated_prob", "uncalibrated_prob", "power", "strength", "none"]},
  "config_id": {"type": "string"},
  "input": {"type": "object"},
  "latency_s": {"type": "number", "minimum": 0}
 },
 "not": {"anyOf": [{"required": ["shown"]}, {"required": ["utterance"]}, {"required": ["unit"]}]}
}
