{
  "name": "@fidetype/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for NeuralTextStream (NTS): writer, reader, validation, trust_decision helpers and the conformance runner (Node and browser).",
  "keywords": [
    "bci",
    "brain-computer-interface",
    "neural-interface",
    "neuraltextstream",
    "nts",
    "emg",
    "eeg",
    "meg",
    "text-entry",
    "conformance"
  ],
  "homepage": "https://github.com/zhangzibo/fidetype/tree/main/sdk/typescript#readme",
  "bugs": {
    "url": "https://github.com/zhangzibo/fidetype/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangzibo/fidetype.git",
    "directory": "sdk/typescript"
  },
  "license": "Apache-2.0",
  "author": "zhangzibo",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "fidetype-ts": "./bin/fidetype-ts.mjs"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "gen:schemas": "node scripts/gen-schemas.mjs",
    "check:schemas": "node scripts/gen-schemas.mjs --check",
    "build": "node scripts/gen-schemas.mjs --check && tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "node --test test/core.test.mjs test/vectors.test.mjs test/ws.test.mjs",
    "conformance": "node bin/fidetype-ts.mjs conformance",
    "conformance:kit": "node bin/fidetype-ts.mjs conformance --vectors ../../spec/conformance/kit",
    "cross-check": "node scripts/cross-check.mjs",
    "check:browser": "node scripts/check-browser-safe.mjs",
    "ci": "npm run build && npm run check:version && npm run check:browser && npm test && npm run conformance && npm run conformance:kit",
    "fuzz": "node scripts/fuzz-parity.mjs",
    "check:version": "node scripts/check-version.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build && npm run check:version"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "typescript": "5.9.3"
  }
}
