# Data – never commit recordings or participant data
data/*
!data/.gitkeep
*.fif
*.edf
*.bdf
*.mat
*.npy
*.npz
*.h5
*.hdf5

# Models / outputs
checkpoints/
runs/
*.pt
*.ckpt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# Secrets / env
.env
*.key

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Reference material with third-party licences (see references/README.md)
references/papers/
references/repos/

# Golden conformance vectors are small synthetic fixtures (M5-10); commit them.
!spec/conformance/**/*.npz

# Per-trial participant texts (target + typed). They live in ~/bci-data/derived/ (see LICENSES/DATA.md).
experiments/**/results/trials.json

# M6-08 raw process logs (liblsl INFO lines list network interface ids)
experiments/2026-11-13-m6-08-brainflow-live/out/*.log
